{
  "name": "xtrakto",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @xtrakto/db db:generate",
    "db:migrate": "pnpm --filter @xtrakto/db db:migrate",
    "db:seed": "pnpm --filter web db:seed",
    "db:studio": "pnpm --filter @xtrakto/db db:studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^22.12.0"
  }
}
