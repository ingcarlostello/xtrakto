# Dependencies
node_modules
.pnp
.pnp.*

# Environment: only the documented example is committed
.env*
!.env.example

# Build output and caches
.next/
out/
build
dist
.turbo
.vercel
*.tsbuildinfo
next-env.d.ts

# Testing: Vitest's coverage reports, at the root and in each package. Not
# every folder named coverage: statement coverage is part of the domain.
/coverage/
/apps/*/coverage/
/packages/*/coverage/

# Real bank statements (local development only, any depth)
**/fixtures/private/

# Synthetic XLSX files generated for manual checks (`generate:xlsx`)
**/fixtures/xlsx/

# ML data and artifacts (ml/)
ml/data/
ml/artifacts/

# Debug
npm-debug.log*
.pnpm-debug.log*

# Misc
.DS_Store
*.pem

# Claude Code: per-developer files (shared rules in .claude/rules/ are committed)
.claude/settings.local.json
.remember/
