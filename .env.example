# Environment variables for Xtrakto.
# Copy this file to `.env.local` (git-ignored) and fill in the values.
# Each variable is documented here when the phase that needs it is added.
# The web app reads this root file too (apps/web/next.config.ts) and doesn't
# start if a variable it needs is missing or invalid. Don't create `.env*`
# files inside apps/web: when one changes, `next dev` reloads its environment
# without the values from this file.

# PostgreSQL. These values match docker-compose.yml and work only on this machine.
# Application role: it owns no table and can't bypass Row-Level Security.
# On Neon, use the pooled host (`-pooler` after the endpoint id) and
# `sslmode=verify-full`; the web app rejects a hosted database without it.
DATABASE_URL=postgresql://xtrakto_app:xtrakto_app@127.0.0.1:5432/xtrakto
# Owner role: runs migrations only. On Neon, use the direct host (no `-pooler`).
DATABASE_MIGRATION_URL=postgresql://xtrakto:xtrakto@127.0.0.1:5432/xtrakto

# Integration tests of packages/db, as the application role and as the owner.
# They must point to a local database whose name ends in `_test`. With both set,
# the tests need `docker compose up --wait`; remove both to skip those tests.
TEST_DATABASE_URL=postgresql://xtrakto_app:xtrakto_app@127.0.0.1:5432/xtrakto_test
TEST_DATABASE_MIGRATION_URL=postgresql://xtrakto:xtrakto@127.0.0.1:5432/xtrakto_test

# Secret key for the HMAC-SHA-256 hashes of third-party identifiers, such as the
# phone number in a Nequi transfer reference. At least 32 characters of random
# data, for example: openssl rand -base64 32. Required: the web app doesn't start
# without it.
# Keep it stable: changing it gives the same phone number a different hash, so
# references saved before the change stop grouping with new ones.
IDENTIFIER_HASH_KEY=

# Clerk (authentication): Clerk dashboard > your application > API keys, from
# the development instance locally. Required: the web app doesn't start without
# them, which also keeps Clerk from creating a temporary keyless app. The
# publishable key (pk_) reaches the browser; the secret key (sk_) never does.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: the Clerk user id that `pnpm db:seed` loads the synthetic statements
# for. Set it to your own development user (Clerk dashboard > Users, `user_...`)
# so the seeded data shows up in your account.
SEED_CLERK_USER_ID=
