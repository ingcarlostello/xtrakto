# Environment variables for Xtrakto.
# Copy this file to `.env.local` (git-ignored) and fill in the values.
# Each variable is documented here when the phase that needs it is added.

# Secret key for the HMAC-SHA-256 hashes of third-party identifiers, such as the
# phone number in a Nequi transfer reference. At least 32 characters of random
# data, for example: openssl rand -base64 32
# Keep it stable: changing it gives the same phone number a different hash, so
# references saved before the change stop grouping with new ones.
IDENTIFIER_HASH_KEY=
