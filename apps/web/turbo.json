{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "passThroughEnv": ["SENTRY_AUTH_TOKEN", "VERCEL_GIT_COMMIT_SHA"]
    },
    "test": {
      "dependsOn": ["transit", "@xtrakto/db#test"],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "TEST_DATABASE_MIGRATION_URL",
        "CI"
      ]
    }
  }
}
